<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Due Invoices - Customer Portal ICICI" verbose="1">

    <parameter name="browser" value="chrome"/>

    <!--
    ══════════════════════════════════════════════════════════════
     Payment page (onlinepayment) — ICICI four-button layout, 2026-11-12.
     Child IDs: Invoices → Download All Invoice (Due + Overdue),
     one child per test. Force one child: -DiciciChildId=XXXX

     TC_010  UPI                                    payment_json_icici_up
     TC_011  Credit and Debit Card                  payment_json_icici_cc
     TC_012  Net Banking                            payment_json_icici_nb
     TC_013  Amex + International and corporate     payment_json_icici_dc
     TC_014  Credit and Debit Card via ICICI hosted gateway page

     The old TC_002 (#btn_icici_ccdc) and TC_005 (payment_json_icici_ccdc)
     target the removed layout and are no longer in this suite.
    ══════════════════════════════════════════════════════════════
    -->
    <test name="Due Invoices - ICICI">
        <classes>
            <class name="testScripts.SupportTests.DueInvoices_CustomerPortal_ICICI">
                <methods>
                    <include name="tc010_iciciUpiJson"/>
                    <include name="tc011_iciciCreditDebitCardJson"/>
                    <include name="tc012_iciciNetBankingJson"/>
                    <include name="tc013_iciciAmexJson"/>
                    <include name="tc014_iciciCardViaGateway"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
